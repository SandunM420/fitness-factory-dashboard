# Copy this file to .env and fill in real values. NEVER commit .env.
# Tip: use a dedicated READ-ONLY SQL login (db_datareader) for the dashboard.

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FitnessFactory
DB_USER=dashboard_reader
DB_PASSWORD=change-me
# Azure SQL: DB_ENCRYPT=true, DB_TRUST_CERT=false
DB_ENCRYPT=true
DB_TRUST_CERT=true
# Optional named instance, e.g. SQLEXPRESS (leave empty to use DB_PORT)
DB_INSTANCE=

PORT=4000
# Origin of the React app allowed to call the API (dev server by default)
CORS_ORIGIN=http://localhost:5173

# Users, sessions, flavours and sub-products are kept in a local SQLite file
# (default api/data/app.db). Back it up. Override the location with APP_DB_PATH.
# APP_DB_PATH=
# Comma-separated emails that always have super-admin access.
SUPER_ADMIN_EMAILS=owner@example.com
